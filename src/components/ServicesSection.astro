---
// ServicesSection.astro
import services from '../data/services.json';
---

<section class="services-section" id="servicos" aria-labelledby="servicos-title">
  <div class="container">
    
    <div class="section-header">
      <span class="badge-territorio">Nossa Atuação</span>
      <h2 id="servicos-title" class="section-title">
        Três pilares estratégicos para a nova economia criativa.
      </h2>
      <p class="section-subtitle">
        Conectamos a criação artística autoral de games à incubação de talentos e à inteligência estratégica para produtos digitais de impacto.
      </p>
    </div>

    <div class="services-grid">
      {services.map(srv => (
        <article class="service-card" id={srv.id}>
          <div class="service-top">
            <span class="service-number">{srv.number}</span>
            <span class="service-tag">{srv.tag}</span>
          </div>

          <h3 class="service-title">{srv.title}</h3>
          
          <p class="service-desc">{srv.description}</p>

          <div class="service-deliverables">
            <span class="deliv-heading">O que entregamos:</span>
            <ul>
              {srv.deliverables.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <div class="service-highlight">
            <p>"{srv.highlight}"</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .services-section {
    padding-top: clamp(60px, 8vw, 100px);
    padding-bottom: clamp(60px, 8vw, 100px);
    background-color: var(--off-white);
    border-bottom: 1px solid var(--cinza-borda);
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 56px auto;
  }

  .section-header .badge-territorio {
    margin-bottom: 20px;
  }

  .section-title {
    margin-bottom: 20px;
    color: var(--graphite);
    font-size: clamp(2rem, 3.5vw + 0.5rem, 3.25rem);
    letter-spacing: -0.03em;
  }

  .section-subtitle {
    font-size: clamp(1rem, 1vw + 0.75rem, 1.1875rem);
    line-height: 1.6;
    color: #424242;
    margin: 0 auto;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 992px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    background-color: var(--pure-white);
    border: 1px solid var(--cinza-borda);
    border-radius: var(--radius-surface);
    padding: clamp(28px, 4vw, 36px);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--aimo-purple);
  }

  .service-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .service-number {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--aimo-purple);
  }

  .service-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    background-color: rgba(124, 77, 255, 0.08);
    color: var(--aimo-purple);
    border-radius: var(--radius-pill);
  }

  .service-title {
    font-size: 1.375rem;
    color: var(--graphite);
    margin-bottom: 16px;
    line-height: 1.3;
  }

  .service-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #555555;
    margin-bottom: 24px;
  }

  .service-deliverables {
    margin-bottom: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--cinza-borda);
    flex-grow: 1;
  }

  .deliv-heading {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--cinza-medio);
    margin-bottom: 12px;
  }

  .service-deliverables ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .service-deliverables li {
    font-size: 0.875rem;
    color: #333333;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.45;
  }

  .service-deliverables li::before {
    content: "•";
    color: var(--aimo-purple);
    font-size: 1.25rem;
    line-height: 1;
  }

  .service-highlight {
    background-color: var(--warm-gray-light);
    border-radius: var(--radius-control);
    padding: 14px 16px;
    font-size: 0.8125rem;
    font-style: italic;
    color: #424242;
    line-height: 1.5;
  }
</style>
