---
// Footer.astro — Clone Autêntico Ustwo Games (Dark Charcoal Bar + Circular Emblem + Playful Social Pills)
const currentYear = new Date().getFullYear();
---

<footer class="ustwo-footer" id="rodape">
  <div class="container footer-container">
    
    <!-- LINHA PRINCIPAL SUPERIOR -->
    <div class="footer-main-row">
      
      <!-- LOGO CIRCULAR & MISSÃO (CLONE DE USTWO) -->
      <div class="footer-mission-col">
        <a href="#aimotech" class="footer-brand-badge" aria-label="Aimotech Início">
          <svg width="84" height="74" viewBox="0 0 160 140" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="footer-logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#7C4DFF" />
                <stop offset="50%" stop-color="#2E7D5B" />
                <stop offset="100%" stop-color="#B75A36" />
              </linearGradient>
            </defs>
            <path d="M 20 10 L 140 10 Q 150 10 150 20 L 150 85 Q 150 125 80 138 Q 10 125 10 85 L 10 20 Q 10 10 20 10 Z" fill="#ffffff" stroke="#000000" stroke-width="4" />
            <path d="M 26 16 L 134 16 Q 142 16 142 24 L 142 80 Q 142 116 80 128 Q 18 116 18 80 L 18 24 Q 18 16 26 16 Z" fill="url(#footer-logo-grad)" />
            <text x="80" y="58" text-anchor="middle" font-family="'Manrope', sans-serif" font-weight="900" font-size="24" fill="#ffffff" letter-spacing="-1">AIMO</text>
            <text x="80" y="82" text-anchor="middle" font-family="'Manrope', sans-serif" font-weight="800" font-size="14" fill="#ffffff" letter-spacing="2">GAMES</text>
            <circle cx="80" cy="100" r="4" fill="#FFD734" />
          </svg>
        </a>
        <div class="mission-text-wrap">
          <p class="mission-quote">
            Experiências lúdicas que inspiram transformação, memória e impacto territorial.
          </p>
          <span class="mission-coords">
            Salvador (12° 58' S) · Mucugê (12° 59' S) · Bahia, Brasil
          </span>
        </div>
      </div>

      <!-- SELOS & CERTIFICAÇÕES DE IMPACTO -->
      <div class="footer-badges-col">
        <div class="impact-badge">
          <span class="b-mark">BA</span>
          <span class="b-txt">Territorial<br/>Game Studio</span>
        </div>
        <div class="impact-badge">
          <span class="b-mark">LPG</span>
          <span class="b-txt">Fomento<br/>Paulo Gustavo</span>
        </div>
      </div>

    </div>

    <!-- LINHA DE LINKS E REDES SOCIAIS -->
    <div class="footer-links-row">
      <div class="footer-nav-pills">
        <a href="#aimotech" class="f-nav-link">Sobre Nós</a>
        <a href="#manifesto" class="f-nav-link">Manifesto</a>
        <a href="#jogos" class="f-nav-link">Nossos Jogos</a>
        <a href="https://www.trilhasdaterra.com.br" target="_blank" rel="noopener noreferrer" class="f-nav-link f-highlight">Trilhas da Terra ↗</a>
        <a href="#black-xp" class="f-nav-link">Black XP</a>
        <a href="#servicos" class="f-nav-link">Serviços</a>
        <a href="#contato" class="f-nav-link">Contato</a>
      </div>

      <div class="footer-social-icons">
        <a href="https://www.instagram.com/gametrilhasdaterra" target="_blank" rel="noopener noreferrer" class="social-circle" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a href="mailto:contato@aimotech.com.br" class="social-circle" aria-label="Email">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- COPYRIGHT INFERIOR -->
    <div class="footer-bottom-copy">
      <span>© {currentYear} Aimotech Games. Todos os direitos reservados. Feito com rigor antropológico e engenharia independente na Bahia.</span>
      <a href="#aimotech" class="back-top-btn">Voltar ao topo ↑</a>
    </div>

  </div>
</footer>

<style>
  /* RODAPÉ PRETO / CHARCOAL ESCURO IDÊNTICO À USTWO GAMES */
  .ustwo-footer {
    background-color: #171717;
    color: #ffffff;
    padding-top: 56px;
    padding-bottom: 32px;
    border-top: 2px solid #282828;
  }

  .footer-container {
    max-width: 1320px;
  }

  /* LINHA PRINCIPAL */
  .footer-main-row {
    display: flex;
    flex-direction: column;
    gap: 32px;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid #2C2C2C;
    padding-bottom: 40px;
    margin-bottom: 32px;
  }

  @media (min-width: 768px) {
    .footer-main-row {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-mission-col {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: 720px;
  }

  .footer-brand-badge {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .footer-brand-badge:hover {
    transform: scale(1.08) rotate(3deg);
  }

  .mission-quote {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.4;
    margin-bottom: 6px;
  }

  .mission-coords {
    font-family: monospace;
    font-size: 0.8125rem;
    color: #9E9E9E;
  }

  /* SELOS DE IMPACTO */
  .footer-badges-col {
    display: flex;
    gap: 16px;
  }

  .impact-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background-color: #222222;
    border: 1px solid #383838;
    border-radius: 12px;
  }

  .b-mark {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1rem;
    color: var(--aimo-purple);
  }

  .b-txt {
    font-size: 0.6875rem;
    font-weight: 600;
    color: #BDBDBD;
    line-height: 1.25;
    text-transform: uppercase;
  }

  /* LINHA DE NAVEGAÇÃO E REDES */
  .footer-links-row {
    display: flex;
    flex-direction: column;
    gap: 24px;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 32px;
    border-bottom: 1px solid #222222;
    margin-bottom: 24px;
  }

  @media (min-width: 992px) {
    .footer-links-row {
      flex-direction: row;
    }
  }

  .footer-nav-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
  }

  .f-nav-link {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    color: #BDBDBD;
    transition: color 0.15s ease;
  }

  .f-nav-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .f-highlight {
    color: #81C784 !important;
  }

  /* REDES SOCIAIS EM CÍRCULOS (CLONE DE USTWO) */
  .footer-social-icons {
    display: flex;
    gap: 14px;
  }

  .social-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #262626;
    color: #ffffff;
    border: 1.5px solid #383838;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .social-circle:hover {
    background-color: var(--aimo-purple);
    border-color: var(--aimo-purple);
    transform: translateY(-2px);
  }

  /* COPYRIGHT */
  .footer-bottom-copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    color: #757575;
  }

  @media (min-width: 768px) {
    .footer-bottom-copy {
      flex-direction: row;
    }
  }

  .back-top-btn {
    color: #9E9E9E;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .back-top-btn:hover {
    color: #ffffff;
  }
</style>
