---
// Hero.astro — Clone Autêntico Ustwo Games (Full-bleed Scenic + Sound Pill + Giant Display Title)
---

<section class="ustwo-hero-section" id="aimotech" aria-label="Apresentação do Estúdio">
  
  <!-- CENÁRIO PANORÂMICO CLEAN SEM CORTES DE TEXTO -->
  <div class="hero-media-wrapper">
    <picture>
      <source srcset="/assets/jogos/trilhas-da-terra/hero_sunset.webp" type="image/webp" />
      <img 
        src="/assets/jogos/trilhas-da-terra/hero_sunset.webp" 
        alt="Cenário do jogo Trilhas da Terra na Chapada Diamantina com o corredor mítico"
        class="hero-scenic-img"
        fetchpriority="high"
        loading="eager"
        width="1920"
        height="1080"
      />
    </picture>

    <!-- Overlay sutil de atmosfera quente da Bahia -->
    <div class="hero-atmospheric-gradient"></div>
  </div>

  <!-- CONTEÚDO SUPERIOR DO HERO (FLOATING CHIPS) -->
  <div class="hero-top-content">
    <div class="container hero-container">
      <div class="hero-floating-badges">
        <span class="brand-btn-ustwo hero-chip tilt-neg-2">
          <span class="chip-dot"></span>
          <span>Bahia, Brasil · Território & Tecnologia</span>
        </span>
        <a href="https://www.trilhasdaterra.com.br" target="_blank" rel="noopener noreferrer" class="brand-btn-ustwo hero-chip tilt-pos-2 btn-yellow">
          <span>Trilhas da Terra Beta 2026 ↗</span>
        </a>
      </div>
    </div>
  </div>

  <!-- BARRA INFERIOR DO HERO (CLONE IDÊNTICO DE USTWO GAMES) -->
  <div class="hero-bottom-bar">
    <div class="container bottom-container">
      
      <!-- BOTÃO DE SOM REDONDO AMARELO (IGUAL AO USTWO GAMES) -->
      <div class="sound-toggle-wrap">
        <button type="button" class="ustwo-sound-btn" id="sound-toggle" aria-label="Ligar ou desligar som ambiente">
          <span class="sound-icon-off" id="icon-sound-off">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <line x1="23" y1="9" x2="17" y2="15"></line>
              <line x1="17" y1="9" x2="23" y2="15"></line>
            </svg>
          </span>
          <span class="sound-icon-on" id="icon-sound-on" hidden>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            </svg>
          </span>
          <span class="sound-tooltip">Áudio Ambiente</span>
        </button>
      </div>

      <!-- TÍTULO GIGANTE DISPLAY (CLONE DE OUR GAMES) -->
      <div class="hero-giant-title-wrap">
        <h1 class="ustwo-giant-title">Nossos Jogos</h1>
      </div>

    </div>
  </div>

</section>

<style>
  .ustwo-hero-section {
    position: relative;
    width: 100%;
    height: 90vh;
    min-height: 620px;
    max-height: 960px;
    background-color: #2E7D5B;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* CENÁRIO FULL-BLEED */
  .hero-media-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .hero-scenic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transform: scale(1.02);
    transition: transform 6s ease-out;
  }

  .ustwo-hero-section:hover .hero-scenic-img {
    transform: scale(1.05);
  }

  .hero-atmospheric-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.05) 50%,
      rgba(23, 23, 23, 0.3) 80%,
      rgba(255, 255, 255, 0.95) 100%
    );
    pointer-events: none;
  }

  /* CONTEÚDO SUPERIOR */
  .hero-top-content {
    position: relative;
    z-index: 10;
    padding-top: 130px;
  }

  .hero-floating-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .hero-chip {
    font-size: 0.9375rem;
    padding: 10px 18px;
  }

  .chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #00E676;
    box-shadow: 0 0 8px #00E676;
  }

  /* BARRA INFERIOR COM SOUND PILL E TÍTULO GIGANTE */
  .hero-bottom-bar {
    position: relative;
    z-index: 10;
    width: 100%;
    padding-bottom: 0;
  }

  .bottom-container {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    position: relative;
  }

  /* SOUND PILL AMARELO REDONDO */
  .sound-toggle-wrap {
    margin-bottom: 30px;
    position: relative;
    z-index: 15;
  }

  .ustwo-sound-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: #FFD734;
    color: #171717;
    border: 3px solid #171717;
    box-shadow: 6px 6px 0px rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .ustwo-sound-btn:hover {
    transform: scale(1.1) rotate(6deg) translate(2px, 2px);
    box-shadow: 2px 2px 0px rgba(0, 0, 0, 0.35);
    background-color: #FFE066;
  }

  .sound-tooltip {
    position: absolute;
    left: 80px;
    top: 50%;
    transform: translateY(-50%);
    background: #ffffff;
    color: #171717;
    border: 2px solid #171717;
    border-radius: 10px;
    padding: 4px 10px;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 3px 3px 0px rgba(0, 0, 0, 0.2);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .ustwo-sound-btn:hover .sound-tooltip {
    opacity: 1;
  }

  /* TÍTULO GIGANTE DISPLAY (CLONE DE OUR GAMES) */
  .hero-giant-title-wrap {
    position: relative;
    line-height: 0.85;
    margin-bottom: -15px;
  }

  .ustwo-giant-title {
    font-family: var(--font-display), 'Fraunces', serif;
    font-size: clamp(3.5rem, 9.5vw, 9.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #ffffff;
    text-shadow: 0 8px 30px rgba(0, 0, 0, 0.45);
    margin: 0;
    padding: 0;
  }
</style>

<script>
  const soundBtn = document.getElementById('sound-toggle');
  const iconOff = document.getElementById('icon-sound-off');
  const iconOn = document.getElementById('icon-sound-on');

  let audioCtx: AudioContext | null = null;
  let isPlaying = false;
  let oscillator: OscillatorNode | null = null;
  let gainNode: GainNode | null = null;

  soundBtn?.addEventListener('click', () => {
    if (!isPlaying) {
      const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      audioCtx = new AudioContextClass();
      
      oscillator = audioCtx.createOscillator();
      gainNode = audioCtx.createGain();

      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(220, audioCtx.currentTime);
      gainNode.gain.setValueAtTime(0.04, audioCtx.currentTime);

      oscillator.connect(gainNode);
      gainNode.connect(audioCtx.destination);
      oscillator.start();

      isPlaying = true;
      iconOff?.setAttribute('hidden', '');
      iconOn?.removeAttribute('hidden');
    } else {
      if (oscillator) {
        oscillator.stop();
        oscillator.disconnect();
      }
      if (audioCtx) {
        audioCtx.close();
      }
      isPlaying = false;
      iconOn?.setAttribute('hidden', '');
      iconOff?.removeAttribute('hidden');
    }
  });
</script>
