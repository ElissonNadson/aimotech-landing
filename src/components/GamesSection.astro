---
// GamesSection.astro — Clone Autêntico de https://ustwogames.co.uk/our-games/
import projects from '../data/projects.json';

const trilhas = projects.find(p => p.id === 'trilhas-da-terra');
const algodao = projects.find(p => p.id === 'algodao-doce');
const tagboy = projects.find(p => p.id === 'tagboy');
const biografia = projects.find(p => p.id === 'biografia-preta');
const pvsc = projects.find(p => p.id === 'pvsc-sequeladus');
---

<section class="ustwo-games-canvas" id="jogos" aria-label="Vitrine de Jogos Autorais">
  <div class="container games-container">

    <!-- INTRO HEADER SUTIL (ESTILO USTWO GAMES) -->
    <div class="games-editorial-intro">
      <div class="editorial-badge-row">
        <span class="brand-btn-ustwo intro-pill tilt-neg-2">
          <span>Estúdio Autoral de Games</span>
        </span>
      </div>
      <p class="editorial-manifesto">
        Criamos universos lúdicos artesanais onde o território da Bahia, a arquitetura ancestral e a vanguarda tecnológica convergem em experiências poéticas, acessíveis e inesquecíveis.
      </p>
    </div>

    <!-- LISTA DE JOGOS AUTORAIS — LAYOUT ZIG-ZAG IDÊNTICO À USTWO GAMES -->
    <div class="ustwo-showcase-list">

      <!-- ================= 01. TRILHAS DA TERRA ================= -->
      {trilhas && (
        <article class="ustwo-feature-row row-trilhas" id={trilhas.id}>
          
          <div class="feature-text-col">
            <div class="feature-meta-pill">
              <span class="meta-tag tag-green">Game Autoral 3D</span>
              <span class="meta-dot">·</span>
              <span class="meta-place">Chapada Diamantina</span>
            </div>

            <h2 class="feature-title">{trilhas.title}</h2>
            
            <p class="feature-quote">
              “{trilhas.quote}”
            </p>

            <p class="feature-synopsis">
              {trilhas.description}
            </p>

            <div class="feature-highlights">
              <div class="hl-item">
                <span class="hl-k">Gênero</span>
                <span class="hl-v">Infinity Runner Narrativo & Leitura de Terreno</span>
              </div>
              <div class="hl-item">
                <span class="hl-k">Território</span>
                <span class="hl-v">Mucugê, Vale do Pati e Quilombo de Barriguda</span>
              </div>
              <div class="hl-item">
                <span class="hl-k">Apoio</span>
                <span class="hl-v">Lei Paulo Gustavo · Bahia, Brasil</span>
              </div>
            </div>

            <div class="feature-action-row">
              <a 
                href={trilhas.website} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="brand-btn-ustwo btn-colored tilt-neg-2"
                title="Acessar o site oficial de Trilhas da Terra"
              >
                <span>Visitar Site Oficial trilhasdaterra.com.br</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>

              <a 
                href="https://www.instagram.com/gametrilhasdaterra" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="brand-btn-ustwo btn-yellow tilt-pos-2"
              >
                <span>@gametrilhasdaterra ↗</span>
              </a>
            </div>
          </div>

          <div class="feature-art-col">
            <div class="floating-art-wrapper">
              <!-- Arte do cenário da Chapada com recorte do protagonista -->
              <img 
                src={trilhas.image} 
                alt={trilhas.title} 
                class="floating-scene-art"
                loading="lazy"
                width="720"
                height="540"
              />
              <img 
                src={trilhas.characterImage || trilhas.image} 
                alt="Corredor de Trilhas da Terra" 
                class="floating-character-cutout char-trilhas"
                loading="lazy"
                width="340"
                height="340"
              />
            </div>
          </div>

        </article>
      )}

      <!-- ================= 02. ALGODÃO DOCE (REVERSE: ART ESQUERDA) ================= -->
      {algodao && (
        <article class="ustwo-feature-row reverse row-algodao" id={algodao.id}>
          
          <div class="feature-art-col">
            <div class="floating-art-wrapper">
              <img 
                src={algodao.image} 
                alt={algodao.title} 
                class="floating-scene-art phone-art"
                loading="lazy"
                width="600"
                height="600"
              />
              <img 
                src={algodao.characterImage || algodao.image} 
                alt="Personagens Algodão Doce e Floquinho" 
                class="floating-character-cutout char-algodao"
                loading="lazy"
                width="380"
                height="380"
              />
            </div>
          </div>

          <div class="feature-text-col">
            <div class="feature-meta-pill">
              <span class="meta-tag tag-terracota">Arcade Mobile 2D</span>
              <span class="meta-dot">·</span>
              <span class="meta-place">Culinária da Bahia</span>
            </div>

            <h2 class="feature-title">{algodao.title}</h2>
            
            <p class="feature-quote">
              “{algodao.quote}”
            </p>

            <p class="feature-synopsis">
              {algodao.description}
            </p>

            <div class="feature-highlights">
              <div class="hl-item">
                <span class="hl-k">Protagonistas</span>
                <span class="hl-v">Algodão Doce (jogável) e Floquinho (narrativa)</span>
              </div>
              <div class="hl-item">
                <span class="hl-k">Mecânica</span>
                <span class="hl-v">Plataformas doces flutuantes com física que desaba</span>
              </div>
              <div class="hl-item">
                <span class="hl-k">Estado</span>
                <span class="hl-v">Protótipo Jogável em Testes</span>
              </div>
            </div>

            <div class="feature-action-row">
              <a href="#contato" class="brand-btn-ustwo btn-terracota tilt-pos-2">
                <span>Quero Jogar o Beta ➔</span>
              </a>
            </div>
          </div>

        </article>
      )}

      <!-- ================= 03. TAGBOY E A CIDADE CINZA ================= -->
      {tagboy && (
        <article class="ustwo-feature-row row-tagboy" id={tagboy.id}>
          
          <div class="feature-text-col">
            <div class="feature-meta-pill">
              <span class="meta-tag tag-purple">Sci-Fi Afrofuturista</span>
              <span class="meta-dot">·</span>
              <span class="meta-place">Nova Salvador</span>
            </div>

            <h2 class="feature-title">{tagboy.title}</h2>
            
            <p class="feature-quote">
              “{tagboy.quote}”
            </p>

            <p class="feature-synopsis">
              {tagboy.description}
            </p>

            <div class="feature-highlights">
              <div class="hl-item">
                <span class="hl-k">Missão</span>
                <span class="hl-v">Devolver as cores roubadas e a memória de Nova Salvador</span>
              </div>
              <div class="hl-item">
                <span class="hl-k">Controles</span>
                <span class="hl-v">4 personagens jogáveis, pulo duplo, spray de grafite e puzzles</span>
              </div>
              <div class="hl-item">
                <span class="hl-k">Estilo</span>
                <span class="hl-v">Plataforma 2D de Ação Urbana</span>
              </div>
            </div>

            <div class="feature-action-row">
              <a href="#contato" class="brand-btn-ustwo btn-colored tilt-neg-2">
                <span>Conhecer o Universo de Tagboy ➔</span>
              </a>
            </div>
          </div>

          <div class="feature-art-col">
            <div class="floating-art-wrapper">
              <img 
                src={tagboy.image} 
                alt={tagboy.title} 
                class="floating-scene-art tagboy-art"
                loading="lazy"
                width="640"
                height="640"
              />
            </div>
          </div>

        </article>
      )}

      <!-- ================= 04. BIOGRAFIA PRETA (REVERSE: ART ESQUERDA) ================= -->
      {biografia && (
        <article class="ustwo-feature-row reverse row-biografia" id={biografia.id}>
          
          <div class="feature-art-col">
            <div class="floating-art-wrapper">
              <img 
                src={biografia.image} 
                alt={biografia.title} 
                class="floating-scene-art meta-art"
                loading="lazy"
                width="720"
                height="450"
              />
            </div>
          </div>

          <div class="feature-text-col">
            <div class="feature-meta-pill">
              <span class="meta-tag tag-blue">Metaverso & IA</span>
              <span class="meta-dot">·</span>
              <span class="meta-place">Leis 10.639 e 11.645</span>
            </div>

            <h2 class="feature-title">{biografia.title}</h2>
            
            <p class="feature-quote">
              “{biografia.quote}”
            </p>

            <p class="feature-synopsis">
              {biografia.description}
            </p>

            <div class="feature-highlights">
              <div class="hl-item">
                <span class="hl-k">Inteligência Artificial</span>
                <span class="hl-v">Wini.IA — suporte docente e pesquisa histórica afro</span>
              </div>
              <div class="hl-item">
                <span class="hl-k">Ambiente</span>
                <span class="hl-v">Exploração 3D de personalidades e heróis da diáspora</span>
              </div>
              <div class="hl-item">
                <span class="hl-k">Impacto</span>
                <span class="hl-v">Material pedagógico acessível para escolas e museus</span>
              </div>
            </div>

            <div class="feature-action-row">
              <a href="#contato" class="brand-btn-ustwo btn-blue tilt-pos-2">
                <span>Levar para sua Escola ou Museu ➔</span>
              </a>
            </div>
          </div>

        </article>
      )}

      <!-- ================= 05. PVSC SEQUELADUS DO SALVADOR ================= -->
      {pvsc && (
        <article class="ustwo-feature-row row-pvsc" id={pvsc.id}>
          
          <div class="feature-text-col">
            <div class="feature-meta-pill">
              <span class="meta-tag tag-terracota">Crônicas Visuais & HQ</span>
              <span class="meta-dot">·</span>
              <span class="meta-place">Baía de Todos os Santos</span>
            </div>

            <h2 class="feature-title">{pvsc.title}</h2>
            
            <p class="feature-quote">
              “{pvsc.quote}”
            </p>

            <p class="feature-synopsis">
              {pvsc.description}
            </p>

            <div class="feature-highlights">
              <div class="hl-item">
                <span class="hl-k">Território</span>
                <span class="hl-v">Elevador Lacerda, Pelourinho e Cidade Baixa</span>
              </div>
              <div class="hl-item">
                <span class="hl-k">Estilo</span>
                <span class="hl-v">HQ, pixel art e ambientação cartográfica autoral</span>
              </div>
              <div class="hl-item">
                <span class="hl-k">Fase</span>
                <span class="hl-v">Concepção Visual e Pesquisa Territorial</span>
              </div>
            </div>

            <div class="feature-action-row">
              <a href="#contato" class="brand-btn-ustwo btn-colored tilt-neg-2">
                <span>Acompanhar Desenvolvimento ➔</span>
              </a>
            </div>
          </div>

          <div class="feature-art-col">
            <div class="floating-art-wrapper">
              <img 
                src={pvsc.image} 
                alt={pvsc.title} 
                class="floating-scene-art pvsc-art"
                loading="lazy"
                width="640"
                height="480"
              />
            </div>
          </div>

        </article>
      )}

    </div>

    <!-- BANNER DE COMUNIDADE ESTILO DISCORD USTWO GAMES -->
    <div class="ustwo-community-banner">
      <div class="comm-banner-card">
        <div class="comm-content">
          <span class="brand-btn-ustwo comm-pill tilt-neg-2">Comunidade & Playtests</span>
          <h3 class="comm-heading">Faça parte da travessia dos nossos jogos</h3>
          <p class="comm-desc">
            Inscreva-se para receber convites exclusivos de playtest beta de <strong>Trilhas da Terra</strong>, trocar ideias diretamente com os desenvolvedores e acompanhar cada passo das produções autorais da Aimotech.
          </p>
          <div class="comm-btn-row">
            <a href="https://www.trilhasdaterra.com.br" target="_blank" rel="noopener noreferrer" class="brand-btn-ustwo btn-colored tilt-pos-2">
              <span>Inscrever no Beta de Trilhas da Terra ↗</span>
            </a>
            <a href="https://www.instagram.com/gametrilhasdaterra" target="_blank" rel="noopener noreferrer" class="brand-btn-ustwo btn-yellow tilt-neg-2">
              <span>Seguir @gametrilhasdaterra</span>
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* CANVAS BRANCO LIMPO E AREJADO (CLONE DE USTWO GAMES) */
  .ustwo-games-canvas {
    background-color: #ffffff;
    color: var(--graphite);
    padding-top: clamp(60px, 8vw, 110px);
    padding-bottom: clamp(60px, 8vw, 110px);
    position: relative;
  }

  .games-container {
    max-width: 1320px;
  }

  /* INTRO EDITORIAL */
  .games-editorial-intro {
    text-align: center;
    max-width: 840px;
    margin: 0 auto clamp(60px, 8vw, 90px) auto;
  }

  .editorial-badge-row {
    margin-bottom: 24px;
    display: flex;
    justify-content: center;
  }

  .intro-pill {
    font-size: 0.9375rem;
    padding: 10px 22px;
  }

  .editorial-manifesto {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 600;
    line-height: 1.5;
    color: #333333;
    letter-spacing: -0.01em;
  }

  /* LISTA ZIG-ZAG DE JOGOS */
  .ustwo-showcase-list {
    display: flex;
    flex-direction: column;
    gap: clamp(80px, 12vw, 160px);
    margin-bottom: clamp(80px, 10vw, 140px);
  }

  /* LINHA DE JOGO INDIVIDUAL (SEM BORDA DE CARD) */
  .ustwo-feature-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 992px) {
    .ustwo-feature-row {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 64px;
    }

    .ustwo-feature-row.reverse {
      grid-template-columns: 0.95fr 1.05fr;
    }

    .ustwo-feature-row.reverse .feature-art-col {
      order: 1;
    }

    .ustwo-feature-row.reverse .feature-text-col {
      order: 2;
    }
  }

  /* COLUNA DE TEXTO */
  .feature-text-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .feature-meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-tag {
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    border: 2px solid #171717;
    box-shadow: 3px 3px 0px rgba(0,0,0,0.18);
  }

  .tag-green { background: #E8F5E9; color: var(--verde-mata); }
  .tag-terracota { background: #FBE9E7; color: var(--terracota); }
  .tag-purple { background: #EDE7F6; color: var(--aimo-purple); }
  .tag-blue { background: #E1F5FE; color: var(--azul-profundo); }

  .meta-dot { color: #9E9E9E; }
  .meta-place { color: #616161; }

  /* TÍTULO GIGANTE DISPLAY */
  .feature-title {
    font-family: var(--font-display), 'Fraunces', serif;
    font-size: clamp(2.5rem, 5.5vw, 5rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: #171717;
    margin-bottom: 16px;
  }

  .feature-quote {
    font-size: 1.125rem;
    font-style: italic;
    color: #555555;
    border-left: 3px solid var(--aimo-purple);
    padding-left: 18px;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .feature-synopsis {
    font-size: 1.125rem;
    line-height: 1.65;
    color: #424242;
    margin-bottom: 28px;
  }

  .feature-highlights {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    width: 100%;
    background-color: #FAF8F5;
    border: 2px solid #E8E3DA;
    border-radius: 16px;
    padding: 18px 22px;
    margin-bottom: 32px;
  }

  @media (min-width: 640px) {
    .feature-highlights {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hl-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hl-k {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #757575;
  }

  .hl-v {
    font-size: 0.875rem;
    font-weight: 600;
    color: #171717;
    line-height: 1.35;
  }

  .feature-action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  /* COLUNA DE ARTE FLUTUANTE (SEM CARD QUADRADO) */
  .feature-art-col {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .floating-art-wrapper {
    position: relative;
    width: 100%;
    max-width: 600px;
  }

  .floating-scene-art {
    width: 100%;
    height: auto;
    border-radius: 24px;
    border: 3px solid #171717;
    box-shadow: 12px 12px 0px rgba(0, 0, 0, 0.2);
    display: block;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ustwo-feature-row:hover .floating-scene-art {
    transform: translateY(-6px) scale(1.02);
  }

  .floating-character-cutout {
    position: absolute;
    bottom: -25px;
    right: -25px;
    filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.45));
    transition: transform 0.4s ease;
    pointer-events: none;
  }

  .ustwo-feature-row:hover .floating-character-cutout {
    transform: translateY(-12px) scale(1.06);
  }

  .char-trilhas {
    width: 52%;
    bottom: -30px;
    right: -20px;
  }

  .char-algodao {
    width: 70%;
    bottom: -35px;
    right: -20px;
  }

  /* BANNER DE COMUNIDADE ESTILO USTWO DISCORD */
  .ustwo-community-banner {
    width: 100%;
    background: linear-gradient(135deg, #FAF8F5 0%, #E8E3DA 100%);
    border: 3px solid #171717;
    border-radius: 28px;
    box-shadow: 12px 12px 0px rgba(0, 0, 0, 0.22);
    padding: clamp(36px, 6vw, 64px);
    text-align: center;
  }

  .comm-content {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .comm-heading {
    font-family: var(--font-display), 'Fraunces', serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #171717;
    line-height: 1.1;
  }

  .comm-desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #424242;
    max-width: 64ch;
  }

  .comm-btn-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 10px;
  }
</style>
