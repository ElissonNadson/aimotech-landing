---
// ExperienceSection.astro
import partners from '../data/partners.json';
---

<section class="experience-section" id="experiencia" aria-labelledby="experiencia-title">
  <div class="container">
    
    <div class="section-header">
      <span class="badge-territorio">Reconhecimento & Ecossistema</span>
      <h2 id="experiencia-title" class="section-title">
        Parcerias estratégicas que aceleram nossa visão.
      </h2>
      <p class="section-subtitle">
        A Aimotech é acelerada por fundos de referência, conveniada ao poder público e parceira de instituições culturais internacionais.
      </p>
    </div>

    <!-- PARCEIROS EM GRID COM LOGOS REAIS -->
    <div class="partners-grid">
      {partners.map(p => (
        <div class="partner-card">
          <div class="partner-logo-wrap">
            <img src={p.logo} alt={p.name} class="partner-logo" loading="lazy" width="140" height="40" />
          </div>
          <span class="partner-name">{p.name}</span>
          <span class="partner-role">{p.role}</span>
        </div>
      ))}
    </div>

    <!-- LIDERANÇA E FUNDAÇÃO DO ESTÚDIO -->
    <div class="leadership-banner">
      <div class="leadership-photo-wrap">
        <img 
          src="/assets/fotos/aimotech_liderancas.jpg" 
          alt="Lideranças fundadoras da Aimotech em Salvador" 
          class="leadership-img"
          loading="lazy"
          width="480"
          height="480"
        />
      </div>

      <div class="leadership-info">
        <span class="badge-territorio">Fundação & Liderança</span>
        <h3 class="leadership-title">"Construímos pontes onde antes só existiam barreiras."</h3>
        <p class="leadership-bio">
          Fundada por Tata Ribeiro e um coletivo de desenvolvedores, pesquisadores e artistas baianos, a Aimotech une inovação tecnológica, visão de negócios de impacto e respeito irrestrito às comunidades tradicionais.
        </p>
        <div class="leadership-creds">
          <div class="cred-item">
            <strong>Metodologia Premiada:</strong> Black XP Game Lab chancelada por órgãos municipais e estaduais.
          </div>
          <div class="cred-item">
            <strong>Preservação Registrada:</strong> Acordo de cooperação com a Associação Quilombola de Barriguda (Mucugê, Chapada Diamantina).
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .experience-section {
    padding-top: clamp(60px, 8vw, 100px);
    padding-bottom: clamp(60px, 8vw, 100px);
    background-color: var(--off-white);
    border-bottom: 1px solid var(--cinza-borda);
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 56px auto;
  }

  .section-header .badge-territorio {
    margin-bottom: 20px;
  }

  .section-title {
    margin-bottom: 20px;
    color: var(--graphite);
    font-size: clamp(2rem, 3.5vw + 0.5rem, 3.25rem);
    letter-spacing: -0.03em;
  }

  .section-subtitle {
    font-size: clamp(1rem, 1vw + 0.75rem, 1.1875rem);
    line-height: 1.6;
    color: #424242;
    margin: 0 auto;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 64px;
  }

  @media (min-width: 768px) {
    .partners-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .partners-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .partner-card {
    background-color: var(--pure-white);
    border: 1px solid var(--cinza-borda);
    border-radius: var(--radius-surface);
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .partner-card:hover {
    transform: translateY(-3px);
    border-color: var(--aimo-purple);
  }

  .partner-logo-wrap {
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .partner-logo {
    max-height: 38px;
    width: auto;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.85;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  .partner-card:hover .partner-logo {
    filter: grayscale(0%);
    opacity: 1;
  }

  .partner-name {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--graphite);
    margin-bottom: 6px;
  }

  .partner-role {
    font-size: 0.6875rem;
    color: var(--cinza-medio);
    line-height: 1.4;
  }

  /* LEADERSHIP BANNER */
  .leadership-banner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    background-color: var(--warm-gray-light);
    border: 1px solid var(--cinza-borda);
    border-radius: var(--radius-surface);
    overflow: hidden;
    padding: clamp(24px, 4vw, 48px);
    align-items: center;
  }

  @media (min-width: 860px) {
    .leadership-banner {
      grid-template-columns: 320px 1fr;
      gap: 48px;
    }
  }

  .leadership-photo-wrap {
    border-radius: var(--radius-surface);
    overflow: hidden;
    background-color: #333;
    aspect-ratio: 1 / 1;
  }

  .leadership-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .leadership-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .leadership-title {
    font-size: clamp(1.375rem, 2vw, 1.875rem);
    color: var(--graphite);
    line-height: 1.25;
  }

  .leadership-bio {
    font-size: 1rem;
    line-height: 1.6;
    color: #424242;
  }

  .leadership-creds {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--cinza-borda);
  }

  .cred-item {
    font-size: 0.875rem;
    color: #333333;
  }

  .cred-item strong {
    color: var(--graphite);
  }
</style>
