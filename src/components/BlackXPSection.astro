---
// BlackXPSection.astro — Integração Autêntica do Mosaico de Fotos + Mascote 3D Oficial (Estilo Ustwo Games & Portfólio)
import events from '../data/events.json';
import mascote from '../data/mascote.json';
import BlackXPMosaic from './BlackXPMosaic.astro';

// Poses oficiais do Mascote 3D
const mascotHero = mascote.poses.find(p => p.id === 'heroica') || mascote.poses[0];
---

<section class="blackxp-section" id="black-xp" aria-labelledby="blackxp-title">
  <div class="container">
    
    <!-- HEADER EDITORIAL ESTILO USTWO GAMES -->
    <div class="blackxp-header-center">
      <div class="badge-row">
        <span class="brand-btn-ustwo bxp-pill tilt-neg-2">
          <span>Game Lab & Metodologia Proprietária</span>
        </span>
      </div>
      <h2 id="blackxp-title" class="bxp-display-title">Black XP Game Lab</h2>
      <p class="bxp-editorial-lead">
        Formando a vanguarda negra e periférica na indústria de games através de desenvolvimento prático, ancestralidade e tecnologia territorial.
      </p>
    </div>

    <!-- O GRANDE BLOCO DE IMPACTO COM O MASCOTE 3D E O MOSAICO FOTOGRÁFICO -->
    <div class="blackxp-hero-showcase">
      
      <!-- MOSAICO FOTOGRÁFICO DE EVENTOS REAIS (8 FOTOS DO PORTFÓLIO + ACERVO REAL) -->
      <div class="mosaic-visual-frame">
        <div class="mosaic-grid-8">
          <div class="mosaic-photo-cell cell-1">
            <img src="/assets/fotos/black_xp/p5_photo_0_0.webp" alt="Alunas desenvolvedoras no hackathon da Black XP" loading="lazy" />
          </div>
          <div class="mosaic-photo-cell cell-2">
            <img src="/assets/fotos/black_xp/p5_photo_0_1.webp" alt="Desenvolvedor programando na sala de azulejos históricos em Salvador" loading="lazy" />
          </div>
          <div class="mosaic-photo-cell cell-3">
            <img src="/assets/fotos/black_xp/p5_photo_0_2.webp" alt="Estudante apresentando pitch de game no palco" loading="lazy" />
          </div>
          <div class="mosaic-photo-cell cell-4">
            <img src="/assets/fotos/black_xp/p5_photo_0_3.webp" alt="Jovens do laboratório N.A.V.E. desenvolvendo jogos" loading="lazy" />
          </div>
          <div class="mosaic-photo-cell cell-5">
            <img src="/assets/fotos/black_xp/p5_photo_1_0.webp" alt="Auditório com projeção de jogos e alunos da rede pública" loading="lazy" />
          </div>
          <div class="mosaic-photo-cell cell-6">
            <img src="/assets/fotos/black_xp/bxp_hackathon_02.webp" alt="Oficina de co-criação de roteiro e arte para jogos" loading="lazy" />
          </div>
          <div class="mosaic-photo-cell cell-7">
            <img src="/assets/fotos/black_xp/bxp_woman_lab_02.webp" alt="Jovem desenvolvedora e participantes no laboratório" loading="lazy" />
          </div>
          <div class="mosaic-photo-cell cell-8">
            <img src="/assets/fotos/black_xp/p5_photo_1_3.webp" alt="Equipe de mentores e fundadores celebrando troféu de premiação" loading="lazy" />
          </div>
        </div>
      </div>

      <!-- BANNER INFERIOR INTEGRADO: MASCOTE 3D NO CENTRO + TEXTO DAS LEIS FEDERAIS + TÍTULO -->
      <div class="mascote-feature-bar">
        
        <!-- LADO ESQUERDO: TEXTO PEDAGÓGICO E LEIS FEDERAIS -->
        <div class="mascote-desc-col">
          <p class="mascote-statement">
            Preservamos a memória afro através de inteligência artificial, Web3 e metaversos imersivos, criando arquivos e memórias digitais que jamais serão apagadas.
          </p>
          <div class="laws-tag-box">
            <span class="laws-badge">Leis Federais 10.639/03 & 11.645/08</span>
            <span class="laws-desc">Ferramentas pedagógicas acessíveis que levam a cultura afro-brasileira e indígena para o currículo escolar através dos games.</span>
          </div>
        </div>

        <!-- CENTRO: MASCOTE 3D OFICIAL EM DESTAQUE -->
        <div class="mascote-3d-center">
          <div class="mascot-interactive-wrap">
            <img 
              src={mascotHero.src} 
              alt="Mascote 3D Oficial da Black XP" 
              class="mascot-full-render"
              loading="lazy"
              width="360"
              height="360"
            />
            <div class="mascot-name-pill">
              <span class="pulse-dot"></span>
              <span>Mascote Oficial Black XP</span>
            </div>
          </div>
        </div>

        <!-- LADO DIREITO: TÍTULO GIGANTE & CTAS -->
        <div class="mascote-title-col">
          <span class="sub-label">Metodologia de Impacto</span>
          <h3 class="giant-bxp-title">BLACK XP</h3>
          <div class="bxp-cta-group">
            <a href="#contato" class="brand-btn-ustwo btn-colored tilt-pos-2">
              <span>Contratar Edição do Lab ➔</span>
            </a>
            <a href="#experiencia" class="brand-btn-ustwo btn-yellow tilt-neg-2">
              <span>Ver Parcerias</span>
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- SELETOR DE EDIÇÕES DOCUMENTAIS HISTÓRICAS -->
    <div class="editions-selector-wrapper">
      <div class="selector-header">
        <h4 class="selector-heading">Edições Realizadas da Black XP</h4>
        <span class="selector-hint">Selecione para ver detalhes de cada edição</span>
      </div>

      <div class="editions-tab-row" role="tablist" aria-label="Edições Históricas">
        {events.map((evt, idx) => (
          <button 
            type="button" 
            class={`brand-btn-ustwo tab-pill-btn ${idx === 0 ? 'active btn-colored' : ''}`}
            data-target={evt.id}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`panel-${evt.id}`}
            id={`tab-${evt.id}`}
          >
            <span>{evt.name}</span>
            <span class="tab-year-badge">{evt.year}</span>
          </button>
        ))}
      </div>

      <!-- PAINEIS DAS EDIÇÕES -->
      <div class="panels-container">
        {events.map((evt, idx) => (
          <div 
            class={`edition-panel-card ${idx === 0 ? 'active' : ''}`} 
            id={`panel-${evt.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${evt.id}`}
            hidden={idx !== 0}
          >
            <div class="panel-layout">
              <div class="panel-text-block">
                <span class="panel-venue-pill">{evt.date} · {evt.venue}</span>
                <h5 class="panel-headline">“{evt.headline}”</h5>
                <p class="panel-desc">{evt.summary}</p>
                <div class="panel-audience-callout">
                  <strong>Público Impactado:</strong> {evt.audience}
                </div>
                <div class="panel-results-list">
                  <span class="res-title">Resultados Documentados:</span>
                  <ul>
                    {evt.highlights.map(h => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="panel-photo-block">
                <img 
                  src={evt.leadPhoto} 
                  alt={evt.name} 
                  class="panel-lead-img"
                  loading="lazy"
                  width="720"
                  height="480"
                />
                <span class="photo-credit">Registro Oficial · Jefferson Peixoto / Secom PMS</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- MOSAICO EXPANDIDO COM FOTOS 4K DO GOOGLE DRIVE -->
    <div class="extended-mosaic-section">
      <div class="ext-header">
        <h4 class="ext-title">Acervo Fotográfico Completo dos Eventos</h4>
        <p class="ext-sub">Registros autênticos no Museu da Energia, no SENAI Cimatec Park e nas salas históricas do Pelourinho.</p>
      </div>
      <BlackXPMosaic />
    </div>

  </div>
</section>

<style>
  /* SEÇÃO BLACK XP — CLEAN, COM CONTRASTE E ESTILO USTWO GAMES */
  .blackxp-section {
    padding-top: clamp(70px, 9vw, 120px);
    padding-bottom: clamp(70px, 9vw, 120px);
    background-color: #FAF8F5;
    color: var(--graphite);
    border-top: 2px solid #E8E3DA;
    border-bottom: 2px solid #E8E3DA;
  }

  /* HEADER EDITORIAL */
  .blackxp-header-center {
    text-align: center;
    max-width: 860px;
    margin: 0 auto clamp(40px, 6vw, 64px) auto;
  }

  .badge-row {
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
  }

  .bxp-pill {
    font-size: 0.9375rem;
    padding: 10px 22px;
  }

  .bxp-display-title {
    font-family: var(--font-display), 'Fraunces', serif;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: #171717;
    margin-bottom: 18px;
  }

  .bxp-editorial-lead {
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    line-height: 1.6;
    color: #424242;
    margin: 0 auto;
  }

  /* SHOWCASE CARD PRINCIPAL COM MOSAICO E MASCOTE */
  .blackxp-hero-showcase {
    background-color: #ffffff;
    border: 3px solid #171717;
    border-radius: 28px;
    box-shadow: 12px 12px 0px rgba(0, 0, 0, 0.22);
    overflow: hidden;
    margin-bottom: 64px;
  }

  /* MOSAICO DE 8 FOTOS REAIS (IGUAL AO SLIDE DA PÁGINA 5) */
  .mosaic-visual-frame {
    width: 100%;
    background-color: #111111;
    border-bottom: 3px solid #171717;
  }

  .mosaic-grid-8 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3px;
    background-color: #171717;
  }

  @media (min-width: 768px) {
    .mosaic-grid-8 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .mosaic-photo-cell {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #222222;
  }

  .mosaic-photo-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .mosaic-photo-cell:hover img {
    transform: scale(1.08);
  }

  /* BANNER INFERIOR DO MASCOTE + LEIS + TÍTULO */
  .mascote-feature-bar {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: clamp(32px, 5vw, 48px);
    background-color: #ffffff;
    align-items: center;
    position: relative;
  }

  @media (min-width: 992px) {
    .mascote-feature-bar {
      grid-template-columns: 1.1fr 0.8fr 1.1fr;
      gap: 36px;
    }
  }

  /* LADO ESQUERDO: DESCRIÇÃO E LEIS */
  .mascote-desc-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .mascote-statement {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #333333;
    font-weight: 500;
  }

  .laws-tag-box {
    background-color: #F3E5F5;
    border: 2px solid #7C4DFF;
    border-radius: 14px;
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .laws-badge {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.875rem;
    color: #4A148C;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .laws-desc {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #311B92;
  }

  /* CENTRO: MASCOTE 3D OFICIAL */
  .mascote-3d-center {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .mascot-interactive-wrap {
    position: relative;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mascot-full-render {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.35));
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mascot-interactive-wrap:hover .mascot-full-render {
    transform: translateY(-8px) scale(1.05);
  }

  .mascot-name-pill {
    margin-top: 10px;
    background-color: #171717;
    color: #ffffff;
    border: 2px solid #333333;
    border-radius: var(--radius-pill);
    padding: 6px 16px;
    font-size: 0.8125rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.25);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #00E676;
    box-shadow: 0 0 6px #00E676;
  }

  /* LADO DIREITO: TÍTULO GIGANTE */
  .mascote-title-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .sub-label {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--aimo-purple);
    margin-bottom: 6px;
  }

  .giant-bxp-title {
    font-family: var(--font-display), 'Fraunces', serif;
    font-size: clamp(3rem, 6vw, 4.75rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #171717;
    margin-bottom: 24px;
  }

  .bxp-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* SELETOR DE EDIÇÕES */
  .editions-selector-wrapper {
    margin-bottom: 64px;
  }

  .selector-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 20px;
  }

  .selector-heading {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 800;
    color: #171717;
  }

  .selector-hint {
    font-size: 0.875rem;
    color: #666666;
  }

  .editions-tab-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 28px;
  }

  .tab-pill-btn {
    font-size: 1rem;
    padding: 12px 22px;
  }

  .tab-year-badge {
    background: rgba(0, 0, 0, 0.12);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
  }

  .tab-pill-btn.active .tab-year-badge {
    background: rgba(255, 255, 255, 0.25);
  }

  /* CARDS DOS PAINEIS */
  .edition-panel-card {
    display: none;
    background-color: #ffffff;
    border: 3px solid #171717;
    border-radius: 24px;
    box-shadow: 8px 8px 0px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    padding: clamp(28px, 4vw, 40px);
  }

  .edition-panel-card.active {
    display: block;
  }

  .panel-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }

  @media (min-width: 992px) {
    .panel-layout {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
    }
  }

  .panel-venue-pill {
    font-family: monospace;
    font-size: 0.875rem;
    color: #7C4DFF;
    font-weight: 700;
    display: inline-block;
    margin-bottom: 12px;
  }

  .panel-headline {
    font-family: var(--font-display), 'Fraunces', serif;
    font-size: clamp(1.5rem, 2.5vw, 2.125rem);
    font-weight: 800;
    line-height: 1.2;
    color: #171717;
    margin-bottom: 16px;
  }

  .panel-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: #424242;
    margin-bottom: 20px;
  }

  .panel-audience-callout {
    background-color: #F5F5F5;
    border-left: 4px solid var(--aimo-purple);
    padding: 12px 18px;
    border-radius: 8px;
    font-size: 0.9375rem;
    color: #212121;
    margin-bottom: 20px;
  }

  .panel-results-list ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
  }

  .panel-results-list li {
    font-size: 0.875rem;
    color: #333333;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .panel-results-list li::before {
    content: "✓";
    color: var(--verde-mata);
    font-weight: 900;
  }

  .panel-photo-block {
    position: relative;
    border-radius: 16px;
    border: 2px solid #171717;
    overflow: hidden;
    box-shadow: 6px 6px 0px rgba(0, 0, 0, 0.2);
  }

  .panel-lead-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .photo-credit {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(0, 0, 0, 0.8);
    color: #ffffff;
    font-size: 0.6875rem;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }

  /* MOSAICO EXPANDIDO */
  .extended-mosaic-section {
    margin-top: 48px;
  }

  .ext-header {
    margin-bottom: 24px;
    border-bottom: 2px solid #E8E3DA;
    padding-bottom: 16px;
  }

  .ext-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: #171717;
    margin-bottom: 6px;
  }

  .ext-sub {
    font-size: 0.9375rem;
    color: #616161;
  }
</style>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-pill-btn');
  const panels = document.querySelectorAll<HTMLElement>('.edition-panel-card');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');

      tabButtons.forEach(b => {
        b.classList.remove('active', 'btn-colored');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active', 'btn-colored');
      btn.setAttribute('aria-selected', 'true');

      panels.forEach(p => {
        if (p.id === `panel-${targetId}`) {
          p.classList.add('active');
          p.hidden = false;
        } else {
          p.classList.remove('active');
          p.hidden = true;
        }
      });
    });
  });
</script>
