---
// ProcessSection.astro

const steps = [
  {
    step: "01",
    title: "Pesquisa & Escuta de Chão",
    description: "Imersão no território, diálogo com anciãos, lideranças quilombolas e moradores para compreender a essência cultural e oral antes de qualquer linha de código.",
    image: "/assets/fotos/etapa_01_pesquisa.jpg",
    alt: "Pesquisa territorial e escuta de campo na Bahia"
  },
  {
    step: "02",
    title: "Co-criação Territorial",
    description: "Workshops de narrativa e roteiro com estudantes e artistas locais. Os elementos do jogo nascem das vivências de quem habita a região.",
    image: "/assets/fotos/etapa_02_cocriacao.jpg",
    alt: "Oficina de co-criação com jovens e artistas locais"
  },
  {
    step: "03",
    title: "Engenharia & Prototipagem",
    description: "Desenvolvimento técnico em engines modernas, combinando arte 2D/3D proprietária, testes contínuos de usabilidade e mecânicas responsivas.",
    image: "/assets/fotos/etapa_03_desenvolvimento.jpg",
    alt: "Bancada de desenvolvimento e programação de games"
  },
  {
    step: "04",
    title: "Validação & Circulação",
    description: "Playtests comunitários, lançamentos abertos em escolas e mostras culturais, preparando o jogo para festivais e plataformas globais de distribuição.",
    image: "/assets/fotos/etapa_04_validacao.jpg",
    alt: "Validação comunitária e apresentação de jogos prontos"
  }
];
---

<section class="process-section" id="processo" aria-labelledby="processo-title">
  <div class="container">
    
    <div class="section-header">
      <span class="badge-territorio">Metodologia de Criação</span>
      <h2 id="processo-title" class="section-title">
        Como Trabalhamos: Da escuta de chão à publicação.
      </h2>
      <p class="section-subtitle">
        Nosso ciclo de produção combina rigor antropológico, ética comunitária e padrões internacionais de engenharia de software de entretenimento.
      </p>
    </div>

    <div class="process-timeline">
      {steps.map((item) => (
        <article class="process-step-card">
          <div class="step-media">
            <img src={item.image} alt={item.alt} class="step-img" loading="lazy" width="400" height="267" />
            <span class="step-badge-number">{item.step}</span>
          </div>
          <div class="step-content">
            <h3 class="step-title">{item.title}</h3>
            <p class="step-desc">{item.description}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .process-section {
    padding-top: clamp(60px, 8vw, 100px);
    padding-bottom: clamp(60px, 8vw, 100px);
    background-color: var(--warm-gray);
    border-bottom: 1px solid var(--cinza-borda);
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 56px auto;
  }

  .section-header .badge-territorio {
    margin-bottom: 20px;
  }

  .section-title {
    margin-bottom: 20px;
    color: var(--graphite);
    font-size: clamp(2rem, 3.5vw + 0.5rem, 3.25rem);
    letter-spacing: -0.03em;
  }

  .section-subtitle {
    font-size: clamp(1rem, 1vw + 0.75rem, 1.1875rem);
    line-height: 1.6;
    color: #424242;
    margin: 0 auto;
  }

  .process-timeline {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  @media (min-width: 640px) {
    .process-timeline {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .process-timeline {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .process-step-card {
    background-color: var(--pure-white);
    border: 1px solid var(--cinza-borda);
    border-radius: var(--radius-surface);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .process-step-card:hover {
    transform: translateY(-4px);
    border-color: var(--aimo-purple);
  }

  .step-media {
    position: relative;
    aspect-ratio: 16 / 10;
    background-color: #2D2520;
    overflow: hidden;
  }

  .step-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .process-step-card:hover .step-img {
    transform: scale(1.04);
  }

  .step-badge-number {
    position: absolute;
    top: 12px;
    left: 12px;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 800;
    background-color: var(--aimo-purple);
    color: var(--pure-white);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }

  .step-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .step-title {
    font-size: 1.1875rem;
    color: var(--graphite);
    margin-bottom: 12px;
  }

  .step-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: #555555;
  }
</style>
